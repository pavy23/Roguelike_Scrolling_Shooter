<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Shmup.Core.Standalone</AssemblyName>
    <RootNamespace>Shmup.Core</RootNamespace>
    <!-- Sources live under Assets/ and are linked in below; nothing local to compile. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\..\Assets\Tests\EditMode\**\*.cs" LinkBase="Tests" />
    <Compile Include="RunManagerAllocationTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- NUnit 3.x pinned: Unity's Test Framework is NUnit 3-based, and tests are shared verbatim. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
